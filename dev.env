# Local development. Variables already set in the environment override these.
HEALTH_PORT=8084
# Work already started may continue this long after a stop signal.
SHUTDOWN_GRACE=30s
# Name of this worker in claims; empty = the host name (the pod name in Kubernetes).
WORKER_ID=worker-response-local

# Integrator.Api (halyk-genai-integrator).
INTEGRATOR_URL=http://localhost:8080
INTEGRATOR_TIMEOUT=10s
# A call that cannot reach the API (network error, 502/503/504) is tried again 3 times, 500ms apart.
INTEGRATOR_RETRIES=3
INTEGRATOR_RETRY_DELAY=500ms

# After a round without work a loop waits 1s, doubling up to 10s.
LOOP_IDLE_DELAY=1s
LOOP_MAX_IDLE_DELAY=10s

# Checking on tasks at AI: 4 claimed per round, 2 checked at once. How often a
# task is checked is Integrator.Api's choice (POLL_INTERVAL there).
POLL_BATCH_SIZE=4
POLL_WORKERS=2

# AI team's services, one base URL per operation: local mock-ai-api.
AI_REGISTER_COMPARE_URL=http://localhost:8081/register-compare
AI_SOCIAL_MEDIA_URL=http://localhost:8081/social-media
# One status GET; well under the 30s poll claim lease.
AI_TIMEOUT=10s
# Biggest AI answer passed on; Integrator.Api accepts request bodies up to 1 MiB (1048576).
AI_MAX_RESPONSE_BYTES=1000000
